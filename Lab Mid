```python
from medmnist import BloodMNIST

raw = {s: BloodMNIST(split=s, download=True, size=64, root=ROOT) for s in ["train", "val", "test"]}

def make_subset(ds, n_per_class):
    imgs, labs = ds.imgs, ds.labels.ravel()
    idx = []
    for cid in CLASS_IDS:
        pool = np.where(labs == cid)[0]
        idx.extend(rng.choice(pool, size=n_per_class, replace=False))
    idx = np.array(idx)
    new_y = np.array([CLASS_IDS.index(l) for l in labs[idx]])
    return imgs[idx], new_y

def prep(imgs):

    out = []
    for im in imgs:
        g = cv2.cvtColor(im, cv2.COLOR_RGB2GRAY)
        g = cv2.resize(g, (128, 128), interpolation=cv2.INTER_LINEAR)
        out.append(g.astype(np.float32) / 255.0)
    return np.stack(out)

def to_u8(X):
    return np.clip(np.rint(X * 255), 0, 255).astype(np.uint8)

sizes = {"train": N_TRAIN, "val": N_VAL, "test": N_TEST}
data = {}
for s in ["train", "val", "test"]:
