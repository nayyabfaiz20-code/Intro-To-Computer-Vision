def rotate_all(X, deg=20):
    M = cv2.getRotationMatrix2D((64, 64), deg, 1.0)
    return np.stack([cv2.warpAffine(im, M, (128, 128), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=0) for im in X])

def noise_all(X, sigma=0.05):
    nrng = np.random.default_rng(SEED)
    return np.clip(X + nrng.normal(0, sigma, X.shape), 0, 1).astype(np.float32)

