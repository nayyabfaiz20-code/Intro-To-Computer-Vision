```python
def fit_select(Ftr, ytr, Fva, yva, name):

    results, models = [], {}
    for C in C_GRID:
        m = make_pipeline(StandardScaler(), LinearSVC(C=C, max_iter=20000, random_state=SEED))
        m.fit(Ftr, ytr)
        p = m.predict(Fva)
        results.append({"C": C, "val_acc": accuracy_score(yva, p), "val_macroF1": f1_score(yva, p, average="macro")})
        models[C] = m
    df = pd.DataFrame(results); print(df.to_string(index=False))
    bestC = max(C_GRID, key=lambda c: (df.loc[df.C == c, "val_acc"].item(), df.loc[df.C == c, "val_macroF1"].item()))
    model = models[bestC]; p = model.predict(Fva)
    acc, f1 = accuracy_score(yva, p), f1_score(yva, p, average="macro")
    cm = confusion_matrix(yva, p, labels=range(4))
    print(f"\n{name}: best C = {bestC} | validation accuracy = {acc:.4f} | macro-F1 = {f1:.4f}")
    print("Confusion matrix (rows = true, cols = predicted):\n", cm)
    ConfusionMatrixDisplay(cm, display_labels=CLASS_NAMES).plot(cmap="Blues", xticks_rotation=30)
    plt.title(f"{name} - validation"); plt.show()
    return model, bestC, cm

hog_model, hog_C, hog_cm = fit_select(Htr, ytr, Hva, yva, "HOG + SVM")
```

